--- /dev/null
+++ b/switch/meson.build
@@ -0,0 +1,5 @@
+# Nintendo Switch (libnx) platform code
+global_sources += files(
+    'switch_http_stub.cpp',
+    'switch_main.cpp',
+)
diff --git a/switch/nro/meson.build b/switch/nro/meson.build
new file mode 100644
index 00000000..c5f783ac
--- /dev/null
+++ b/switch/nro/meson.build
@@ -0,0 +1,25 @@
+# Package the executable as a homebrew .nro, with a RomFS made of
+# switch/romfs-root/
+nacp = custom_target(
+    'nacp',
+    output: meson.project_name() + '.nacp',
+    command: [
+        find_program('nacptool'), '--create',
+        meson.project_name(), meson.project_name(), meson.project_version(),
+        '@OUTPUT@',
+    ],
+)
+
+custom_target(
+    'nro',
+    input: [mkxpz_exe, nacp],
+    output: meson.project_name() + '.nro',
+    command: [
+        find_program('elf2nro'), '@INPUT0@', '@OUTPUT@', '--nacp=@INPUT1@',
+        '--romfsdir=' + (meson.project_source_root() / 'switch' / 'romfs-root'),
+    ],
+    build_by_default: true,
+    install: true,
+    install_dir: '.',
+    install_tag: meson.project_name(),
+)
diff --git a/switch/switch.ini b/switch/switch.ini
new file mode 100644
index 00000000..8bf2f421
--- /dev/null
+++ b/switch/switch.ini
@@ -0,0 +1,47 @@
+# Meson cross file for Nintendo Switch homebrew (devkitA64 + libnx), for the
+# devkitpro/devkita64 Docker image. Based on GQster's mkxp-z Switch port.
+#
+#   meson setup --cross-file switch/switch.ini --buildtype release build
+#   ninja -C build                  # build/switch/nro/mkxp-z.nro
+#
+# -ftls-model=local-exec: devkitA64 miscompiles -fPIC soft-TLS accesses
+# otherwise. devkitPro builds its portlibs the same way.
+
+[binaries]
+c = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-gcc'
+cpp = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-g++'
+ar = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-gcc-ar'
+strip = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-strip'
+cmake = 'cmake'
+pkg-config = '/opt/devkitpro/portlibs/switch/bin/aarch64-none-elf-pkg-config'
+nacptool = '/opt/devkitpro/tools/bin/nacptool'
+elf2nro = '/opt/devkitpro/tools/bin/elf2nro'
+
+[properties]
+needs_exe_wrapper = true
+
+[built-in options]
+c_args = ['-D__SWITCH__', '-march=armv8-a', '-mtune=cortex-a57', '-mtp=soft', '-fPIE', '-ftls-model=local-exec', '-isystem', '/opt/devkitpro/libnx/include', '-I/opt/devkitpro/portlibs/switch/include']
+# -Wno-template-body: newlib's libstdc++ has no std::stold(std::string), which
+# rapidcsv's unused numeric converter names
+cpp_args = ['-D__SWITCH__', '-march=armv8-a', '-mtune=cortex-a57', '-mtp=soft', '-fPIE', '-ftls-model=local-exec', '-isystem', '/opt/devkitpro/libnx/include', '-I/opt/devkitpro/portlibs/switch/include', '-Wno-template-body']
+c_link_args = ['-specs=/opt/devkitpro/libnx/switch.specs', '-march=armv8-a', '-mtune=cortex-a57', '-mtp=soft', '-fPIE', '-L/opt/devkitpro/portlibs/switch/lib', '-L/opt/devkitpro/libnx/lib']
+cpp_link_args = ['-specs=/opt/devkitpro/libnx/switch.specs', '-march=armv8-a', '-mtune=cortex-a57', '-mtp=soft', '-fPIE', '-L/opt/devkitpro/portlibs/switch/lib', '-L/opt/devkitpro/libnx/lib']
+
+[project options]
+# SDL2 and OpenAL come from devkitPro's portlibs (libnx, and Mesa for
+# EGL/GLES). Everything else is built from the subprojects.
+sdl_system = 'enabled'
+openal_system = 'enabled'
+use_miniffi = false
+openssl = 'disabled'
+
+[cmake]
+# Static libraries only, as in devkitPro's own CMake platform files
+CMAKE_SYSTEM_NAME = 'Generic'
+
+[host_machine]
+system = 'switch'
+cpu_family = 'aarch64'
+cpu = 'cortex-a57'
+endian = 'little'
diff --git a/switch/switch_http_stub.cpp b/switch/switch_http_stub.cpp
new file mode 100644
index 00000000..97b1b1d5
--- /dev/null
+++ b/switch/switch_http_stub.cpp
@@ -0,0 +1,38 @@
+// No HTTP client on Switch (no OpenSSL): requests return an empty response.
+// From GQster's mkxp-z Switch port.
+#ifdef __SWITCH__
+#include "net/net.h"
+
+namespace mkxp_net {
+
+// HTTPResponse implementation
+int HTTPResponse::status() { return 0; }
+std::string &HTTPResponse::body() { return _body; }
+StringMap &HTTPResponse::headers() { return _headers; }
+HTTPResponse::~HTTPResponse() {}
+HTTPResponse::HTTPResponse() : _status(0) {}
+
+// HTTPRequest implementation
+HTTPRequest::HTTPRequest(const char *dest, bool follow_redirects) {
+    (void)dest; (void)follow_redirects;
+}
+HTTPRequest::~HTTPRequest() {}
+
+StringMap &HTTPRequest::headers() { return _headers; }
+
+HTTPResponse HTTPRequest::get() {
+    return HTTPResponse();
+}
+
+HTTPResponse HTTPRequest::post(StringMap &postData) {
+    (void)postData;
+    return HTTPResponse();
+}
+
+HTTPResponse HTTPRequest::post(const char *body, const char *content_type) {
+    (void)body; (void)content_type;
+    return HTTPResponse();
+}
+
+} // namespace mkxp_net
+#endif
diff --git a/switch/switch_main.cpp b/switch/switch_main.cpp
new file mode 100644
index 00000000..7338bdf9
--- /dev/null
+++ b/switch/switch_main.cpp
@@ -0,0 +1,11 @@
+// Nintendo Switch (libnx) process setup: mount the .nro's RomFS, which holds
+// the preload scripts (see src/main.cpp). Based on GQster's mkxp-z Switch
+// port.
+#ifdef __SWITCH__
+// libnx's headers include <assert.h>; keep Ruby's from being picked up
+#define RUBY_ASSERT_H 1
+#include <switch.h>
+
+extern "C" void userAppInit(void) { romfsInit(); }
+extern "C" void userAppExit(void) { romfsExit(); }
+#endif
