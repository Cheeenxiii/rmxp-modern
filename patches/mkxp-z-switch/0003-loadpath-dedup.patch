+    // preload) run before the game's own preload scripts. Do not inject a
+    // second copy of a shim the game already provides: win32_wrap defines
+    // Graphics.update aliases, and loading it twice recurses.
+    auto addSwitchPreload = [&conf](const char *path) {
+      std::string name(path);
+      std::string::size_type slash = name.find_last_of('/');
+      if (slash != std::string::npos)
+        name = name.substr(slash + 1);
+      for (const std::string &existing : conf.preloadScripts) {
+        std::string::size_type pos = existing.find_last_of('/');
+        std::string base = (pos == std::string::npos) ? existing : existing.substr(pos + 1);
+        if (base == name)
+          return;
+      }
+      conf.preloadScripts.insert(conf.preloadScripts.begin(), path);
+    };
+    // Must run first: absolute game paths for require().
+    addSwitchPreload("romfs:/preload/switch_paths.rb");
+    addSwitchPreload("romfs:/preload/require_fallback.rb");
+    addSwitchPreload("romfs:/preload/log_sync.rb");
+    addSwitchPreload("romfs:/preload/win32api_stub.rb");
+    addSwitchPreload("romfs:/preload/win32_wrap.rb");
+    // Shows "Loading <title>..." while the game's scripts load
+    addSwitchPreload("romfs:/preload/loading_screen.rb");
+    // Game Boy style Start/Select, B-to-run and ZL soft reset
+    addSwitchPreload("romfs:/preload/switch_controls.rb");
+    // Debug tracing only: logs what each slow frame spent its time on
+    addSwitchPreload("romfs:/preload/perf_trace.rb");
 #endif
 
