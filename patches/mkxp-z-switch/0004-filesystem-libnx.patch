@@ -70,8 +72,16 @@ std::string filesystemImpl::getCurrentDirectory() {
 
 std::string filesystemImpl::normalizePath(const char *path, bool preferred, bool absolute) {
     fs::path stdPath(path);
-    
-    if (!stdPath.is_absolute() && absolute)
+    bool isAbsolute = stdPath.is_absolute();
+#ifdef __SWITCH__
+    // libnx paths carry a device prefix ("sdmc:/", "romfs:/") that
+    // ghc::filesystem does not recognize as a root.
+    const char *colon = strchr(path, ':');
+    if (colon && colon != path && colon[1] == '/' && !memchr(path, '/', colon - path))
+        isAbsolute = true;
+#endif
+
+    if (!isAbsolute && absolute)
         stdPath = fs::current_path() / stdPath;
 
     stdPath = stdPath.lexically_normal();
diff --git a/src/filesystem/switch_filesystem_shim.h b/src/filesystem/switch_filesystem_shim.h
new file mode 100644
index 00000000..8b4960e0
--- /dev/null
+++ b/src/filesystem/switch_filesystem_shim.h
@@ -0,0 +1,52 @@
+#ifndef SWITCH_FILESYSTEM_SHIM_H
+#define SWITCH_FILESYSTEM_SHIM_H
+/* From GQster's mkxp-z Switch port. */
+#ifdef __SWITCH__
+#include <sys/stat.h>
+#include <unistd.h>
+#include <errno.h>
+/* ghc::filesystem has no Switch target; its Linux code works on newlib */
+#define GHC_OS_LINUX
+#define GHC_OS_DETECTED
+
+#ifndef AT_FDCWD
+#define AT_FDCWD (-100)
+#endif
+#ifndef AT_SYMLINK_NOFOLLOW
+#define AT_SYMLINK_NOFOLLOW 0x100
+#endif
+
+/* Stub unsupported POSIX functions. newlib declares some of these in
+ * gnu++ mode, so the stubs get their own names and these macros send calls
+ * to them. */
+#define symlink mkxpz_switch_symlink
+#define readlink mkxpz_switch_readlink
+#define utimensat mkxpz_switch_utimensat
+#define truncate mkxpz_switch_truncate
+
+static inline int symlink(const char *target, const char *linkpath) {
+    (void)target; (void)linkpath;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline ssize_t readlink(const char *pathname, char *buf, size_t bufsiz) {
+    (void)pathname; (void)buf; (void)bufsiz;
+    errno = EINVAL;
+    return -1;
+}
+
+static inline int utimensat(int dirfd, const char *pathname, 
+                            const struct timespec times[2], int flags) {
+    (void)dirfd; (void)pathname; (void)times; (void)flags;
+    return 0;
+}
+
+static inline int truncate(const char *path, off_t length) {
+    (void)path; (void)length;
+    errno = ENOSYS;
+    return -1;
+}
+
+#endif /* __SWITCH__ */
+#endif /* SWITCH_FILESYSTEM_SHIM_H */
