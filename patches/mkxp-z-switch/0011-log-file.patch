# Writes stdout and stderr to mkxp-z.log next to the .nro, or in the game folder
# without argv[0], overwritten at each launch.

diff --git a/src/main.cpp b/src/main.cpp
index dc7007d2..f3fa3035 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -34,6 +34,7 @@
 #include <SDL_ttf.h>
 
 #include <cassert>
+#include <cstdio>
 #include <cstring>
 #include <vector>
 #include <string>
@@ -295,6 +296,19 @@ int main(int argc, char *argv[]) {
     mkxp_fs::setCurrentDirectory(dataDir);
 #endif
 
+#ifdef __SWITCH__
+    // Log to mkxp-z.log next to the .nro, or in the game folder without
+    // argv[0]. Unbuffered, so that a crash keeps everything written before.
+    std::string logPath = "mkxp-z.log";
+    if (argc > 0 && std::strrchr(argv[0], '/'))
+      logPath = std::string(argv[0], std::strrchr(argv[0], '/') + 1) + logPath;
+    if (std::freopen(logPath.c_str(), "w", stdout)) {
+      dup2(fileno(stdout), STDERR_FILENO);
+      std::setvbuf(stdout, nullptr, _IONBF, 0);
+      std::setvbuf(stderr, nullptr, _IONBF, 0);
+    }
+#endif
+
     /* now we load the config */
     Config conf;
     conf.read(argc, argv);
