+bool switchFileExists(const char *path) {
+  FILE *file = std::fopen(path, "rb");
+  if (!file)
+    return false;
+  std::fclose(file);
+  return true;
+}
+
+std::string switchReadTextFile(const char *path) {
+  FILE *file = std::fopen(path, "rb");
+  if (!file)
+    return std::string();
+  std::string text;
+  char buffer[256];
+  size_t count;
+  while ((count = std::fread(buffer, 1, sizeof(buffer), file)) > 0)
+    text.append(buffer, count);
+  std::fclose(file);
+  while (!text.empty() && (text.back() == '\n' || text.back() == '\r'))
+    text.pop_back();
+  return text;
+}
+
+// RomFS is read-only, and the games write saves and temporary files next to
+// their data. A console build is therefore copied to the SD card once.
+bool switchCopyTree(const std::string &src, const std::string &dst) {
+  DIR *dir = opendir(src.c_str());
+  if (!dir)
+    return false;
+  mkdir(dst.c_str(), 0777);
+  bool ok = true;
+  while (struct dirent *entry = readdir(dir)) {
+    const char *name = entry->d_name;
+    if (!std::strcmp(name, ".") || !std::strcmp(name, ".."))
+      continue;
+    std::string from = src + "/" + name;
+    std::string to = dst + "/" + name;
+    struct stat info;
+    bool is_dir = stat(from.c_str(), &info) == 0 && S_ISDIR(info.st_mode);
+    if (is_dir) {
+      ok = switchCopyTree(from, to) && ok;
+      continue;
+    }
+    FILE *in = std::fopen(from.c_str(), "rb");
+    if (!in) {
+      ok = false;
+      continue;
+    }
+    FILE *out = std::fopen(to.c_str(), "wb");
+    if (!out) {
+      std::fclose(in);
+      ok = false;
+      continue;
+    }
+    char buffer[64 * 1024];
+    size_t count;
+    while ((count = std::fread(buffer, 1, sizeof(buffer), in)) > 0) {
+      if (std::fwrite(buffer, 1, count, out) != count) {
+        ok = false;
+        break;
+      }
+    }
+    std::fclose(in);
+    std::fclose(out);
+  }
+  closedir(dir);
+  return ok;
+}
+
+// Keeps the folder name usable on FAT and without shell metacharacters.
+std::string switchSlug(const std::string &name) {
+  std::string slug;
+  for (char c : name) {
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+        (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_')
+      slug.push_back(c);
+    else if (c == ' ')
+      slug.push_back('_');
+  }
+  if (slug.empty())
+    slug = "game";
+  return slug;
+}
+
+// Standalone build: the game travels inside the .nro's RomFS. It is installed
+// once under sdmc:/switch/mkxp-z/<name>/ and updated when the .nro changes.
+std::string switchInstallRomFSGame() {
+  std::string name = switchReadTextFile("romfs:/name.txt");
+  if (name.empty())
+    name = "game";
+  std::string dest = "sdmc:/switch/mkxp-z/" + switchSlug(name);
+  std::string version = switchReadTextFile("romfs:/version.txt");
+  std::string installedVersion = switchReadTextFile((dest + "/version.txt").c_str());
+  if (!switchFileExists((dest + "/Game.ini").c_str()) || version != installedVersion) {
+    if (switchCopyTree("romfs:/game", dest) && !version.empty()) {
+      FILE *file = std::fopen((dest + "/version.txt").c_str(), "wb");
+      if (file) {
+        std::fwrite(version.c_str(), 1, version.size(), file);
+        std::fclose(file);
+      }
+    }
+  }
+  return dest;
+}
+
+// Game folder search order for console builds:
+// 1. the game inside the .nro's RomFS (standalone console build);
+// 2. the folder passed as the first argument (forwarder);
+// 3. the folder the .nro is in (argv[0]);
+// 4. sdmc:/switch/mkxp-z/game/ (fixed location).
+void switchResolveDataDir(char *dataDir, size_t size, int argc, char *argv[]) {
+  if (switchFileExists("romfs:/game/Game.ini")) {
+    std::string installed = switchInstallRomFSGame();
+    std::strncpy(dataDir, installed.c_str(), size - 1);
+    return;
+  }
+  if (switchFileExists("romfs:/Game.ini")) {
+    std::strncpy(dataDir, "romfs:/", size - 1);
+    return;
+  }
+  if (argc > 1) {
+    std::strncpy(dataDir, argv[1], size - 1);
+    return;
+  }
+  if (argc > 0 && std::strrchr(argv[0], '/')) {
+    std::strncpy(dataDir, argv[0], size - 1);
+    std::strrchr(dataDir, '/')[1] = 0;
+    return;
+  }
+  std::strncpy(dataDir, "sdmc:/switch/mkxp-z/game", size - 1);
+}
