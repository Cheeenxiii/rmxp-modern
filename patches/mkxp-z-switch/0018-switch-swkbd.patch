--- a/switch/switch_main.cpp
+++ b/switch/switch_main.cpp
@@ -241,6 +241,22 @@
 
 extern "C" void userAppExit(void) { romfsExit(); }
 
+// Called from the event thread when a game enables Input.text_input. SDL's
+// Switch port opens the software keyboard asynchronously and only reports the
+// text, so games that wait for Return stay stuck. Show libnx's keyboard
+// directly and return the result, so the caller can inject Return (validated)
+// or Escape (cancelled).
+extern "C" int switchShowKeyboard(char *text, size_t size) {
+  SwkbdConfig kbd;
+  if (R_FAILED(swkbdCreate(&kbd, 0)))
+    return -1;
+  swkbdConfigMakePresetDefault(&kbd);
+  swkbdConfigSetGuideText(&kbd, "Enter text");
+  Result rc = swkbdShow(&kbd, text, size);
+  swkbdClose(&kbd);
+  return R_SUCCEEDED(rc) ? 0 : 1;
+}
+
 // libnx only weakly references userAppInit, so the linker drops this whole
 // translation unit from libmkxp-z.a; main() calls this to keep it, and with it
 // the RomFS mount, in the binary.
