#!/usr/bin/env ruby
# SPDX-FileCopyrightText: 2026 Cheeenxiii
# SPDX-License-Identifier: GPL-3.0-or-later

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "rmxp"

def slug(path)
  File.expand_path(path).sub(Dir.pwd + "/", "").gsub(/[^A-Za-z0-9_.-]+/, "__")
end

def print_audit(result)
  puts "sources: scripts=#{result.scripts} event_fragments=#{result.event_fragments} " \
       "parse_errors=#{result.parse_errors}"
  puts format("  %-34s %12s %12s %12s", "category", "static", "enumerable", "dynamic")
  Rmxp::Audit::CATEGORIES.each do |key, label|
    sup = result.stats[:static][key]
    enum = result.stats[:enumerable][key]
    dyn = result.stats[:dynamic][key]
    puts format("  %-34s %12d %12d %12d", label, sup, enum, dyn) if sup.positive? || enum.positive? || dyn.positive?
  end
  puts format("  %-34s %12d %12d %12d", "event fragments", result.event_fragments, 0, 0)
end

# Reports the compatibility-shim functions the game actually calls, with the
# category of each shim (see Rmxp::Audit::SHIM_APIS) and the Win32API functions
# by DLL. Calls that aren't statically detectable are listed with no count.
def print_shims(result)
  called = Rmxp::Audit::SHIM_APIS.select { |name, _category, _pattern| result.shims[name].positive? }
  puts "shim functions called: #{called.length}/#{Rmxp::Audit::SHIM_APIS.length}"
  called.each do |name, category, _pattern|
    puts format("  %-8s %6d  %s", category, result.shims[name], name)
  end
  undetectable = Rmxp::Audit::SHIM_APIS.select { |_name, _category, pattern| pattern.nil? }
  unless undetectable.empty?
    puts "  (not statically detectable: #{undetectable.map(&:first).join(', ')})"
  end
  if result.win32_api.empty?
    puts "win32api: none"
    return
  end
  puts "win32api calls:"
  result.win32_api.sort.each do |pair, count|
    dll, function = pair.split("!", 2)
    if function.nil?
      puts format("  %6d  %s", count, pair)
      next
    end
    implemented = Rmxp::Audit::WIN32_IMPLEMENTED.fetch(dll, []).include?(function)
    status = implemented ? "implemented" : "unsupported (returns 0)"
    puts format("  %6d  %-44s %s", count, "#{dll}!#{function}", status)
  end
end

command = ARGV.shift

case command
when "unpack"
  game_dir, out_dir = ARGV
  abort "usage: rmxp unpack GAME OUT" unless game_dir && out_dir
  manifest = Rmxp::Project.new(game_dir).unpack(game_dir, out_dir)
  puts "#{manifest['data'].length} data files, scripts: #{manifest['scripts'] ? 'yes' : 'no'}"
when "build"
  project_dir, out_dir = ARGV
  abort "usage: rmxp build PROJECT OUT" unless project_dir && out_dir
  Rmxp::Project.new(project_dir).build(out_dir)
  puts "build: #{out_dir}"
when "roundtrip"
  game_dir = ARGV.shift
  abort "usage: rmxp roundtrip GAME [WORKDIR]" unless game_dir
  work_dir = ARGV.shift || File.join("tmp", "roundtrip", slug(game_dir))
  report = Rmxp::Project.new(game_dir).roundtrip(work_dir)
  puts format("%-40s files=%-4d identical=%d equivalent=%d opaque=%d scripts=%s",
              report["game"], report["files"], report["byte_identical"],
              report["semantic_identical"], report["opaque"], report["scripts"] == 1 ? "ok" : "FAIL")
when "check"
  game_dir = ARGV.shift
  abort "usage: rmxp check GAME [WORKDIR]" unless game_dir
  work_dir = ARGV.shift || File.join("tmp", "check", slug(game_dir))
  report = Rmxp::Check.new(game_dir, work_dir).run
  puts "scripts: #{report.scripts} (#{report.script_errors} error(s)), " \
       "events: #{report.events} fragment(s) (#{report.event_errors} error(s))"
  report.errors.each { |error| puts "  #{error}" }
  exit(report.errors.empty? ? 0 : 1)
when "migrate"
  game_dir, out_dir = ARGV
  abort "usage: rmxp migrate GAME OUT" unless game_dir && out_dir
  result = Rmxp::Migrate.new(game_dir, out_dir).run
  puts "migrate: #{result.scripts} scripts, #{result.regexes} regexes converted, " \
       "#{result.dynamic_flags} /n flags removed, #{result.when_colons} when clauses converted, " \
       "#{result.break_fixes} break/next fixed, #{result.read_bytes} read(1)[0] fixed, " \
       "#{result.proc_returns} proc returns converted, #{result.legacy_aliases} legacy string aliases removed, " \
       "#{result.midis} MIDIs converted to OGG, " \
       "#{result.skipped_scripts} Windows-only scripts skipped, #{result.parse_errors} invalid script(s)"
  puts "output: #{File.expand_path(out_dir)}"
when "audit"
  if ARGV.first == "--scripts"
    ARGV.shift
    dir = ARGV.shift
    abort "usage: rmxp audit --scripts DIR" unless dir
    result = Rmxp::Audit.new(nil, nil).run_scripts_dir(dir)
    print_audit(result)
    print_shims(result)
    exit 0
  end
  game_dir = ARGV.shift
  abort "usage: rmxp audit GAME [WORKDIR] | rmxp audit --scripts DIR" unless game_dir
  work_dir = ARGV.shift || File.join("tmp", "audit", slug(game_dir))
  result = Rmxp::Audit.new(game_dir, work_dir).run
  print_audit(result)
  print_shims(result)
when "package"
  game_dir = ARGV.shift
  out_dir = ARGV.shift
  abort "usage: rmxp package GAME OUT [--platforms linux,windows] [--mkxp-z-linux BIN] [--mkxp-z-windows DIR]" unless game_dir && out_dir
  platforms = %w[linux windows]
  mkxp_linux = nil
  mkxp_windows = nil
  until ARGV.empty?
    case ARGV.shift
    when "--platforms" then platforms = ARGV.shift.to_s.split(",").map(&:strip)
    when "--mkxp-z-linux" then mkxp_linux = ARGV.shift
    when "--mkxp-z-windows" then mkxp_windows = ARGV.shift
    else abort "unknown package option"
    end
  end
  Rmxp::Package.new(game_dir, out_dir, platforms: platforms,
                    mkxp_linux: mkxp_linux, mkxp_windows: mkxp_windows).run
  puts "package: #{File.expand_path(out_dir)}"
when "help", nil
  puts <<~TEXT
    rmxp - convert RPG Maker XP games to text projects and back

      rmxp unpack GAME OUT          extract Data/ and Scripts.rxdata to text
      rmxp build PROJECT OUT        rebuild Data/ and Scripts.rxdata from text
      rmxp roundtrip GAME [WORKDIR] unpack, build and compare with the original
      rmxp check GAME [WORKDIR]     parse every script and event script
      rmxp audit GAME [WORKDIR]     count dynamic Ruby constructs
      rmxp migrate GAME OUT         copy a pre-v19 game and port it to Ruby 3
      rmxp package GAME OUT         ready-to-play folders with mkxp-z included
  TEXT
else
  abort "unknown command: #{command}"
end
