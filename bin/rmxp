#!/usr/bin/env ruby
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "rmxp"

def slug(path)
  File.expand_path(path).sub(Dir.pwd + "/", "").gsub(/[^A-Za-z0-9_.-]+/, "__")
end

def print_audit(result)
  puts "sources: scripts=#{result.scripts} fragments_evenements=#{result.event_fragments} " \
       "erreurs_parsing=#{result.parse_errors}"
  puts format("  %-34s %12s %12s %12s", "catégorie", "supprimable", "énumérable", "dynamique")
  Rmxp::Audit::CATEGORIES.each do |key, label|
    sup = result.stats[:supprimable][key]
    enum = result.stats[:enumerable][key]
    dyn = result.stats[:dynamique][key]
    puts format("  %-34s %12d %12d %12d", label, sup, enum, dyn) if sup.positive? || enum.positive? || dyn.positive?
  end
  puts format("  %-34s %12d %12d %12d", "fragments d'événements", result.event_fragments, 0, 0)
end

command = ARGV.shift

case command
when "unpack"
  game_dir, out_dir = ARGV
  abort "usage: rmxp unpack JEU SORTIE" unless game_dir && out_dir
  manifest = Rmxp::Project.new(game_dir).unpack(game_dir, out_dir)
  puts "#{manifest['data'].length} fichiers de données, scripts: #{manifest['scripts'] ? 'oui' : 'non'}"
when "build"
  project_dir, out_dir = ARGV
  abort "usage: rmxp build PROJET SORTIE" unless project_dir && out_dir
  Rmxp::Project.new(project_dir).build(out_dir)
  puts "build: #{out_dir}"
when "roundtrip"
  game_dir = ARGV.shift
  abort "usage: rmxp roundtrip JEU [TRAVAIL]" unless game_dir
  work_dir = ARGV.shift || File.join("tmp", "roundtrip", slug(game_dir))
  report = Rmxp::Project.new(game_dir).roundtrip(work_dir)
  puts format("%-40s fichiers=%-4d octet=%d sémantique=%d opaque=%d scripts=%s",
              report["game"], report["files"], report["byte_identical"],
              report["semantic_identical"], report["opaque"], report["scripts"] == 1 ? "ok" : "KO")
when "check"
  game_dir = ARGV.shift
  abort "usage: rmxp check JEU [TRAVAIL]" unless game_dir
  work_dir = ARGV.shift || File.join("tmp", "check", slug(game_dir))
  report = Rmxp::Check.new(game_dir, work_dir).run
  puts "scripts: #{report.scripts} (+#{report.script_errors} erreur(s)), " \
       "événements: #{report.events} fragment(s) (+#{report.event_errors} erreur(s))"
  report.errors.each { |error| puts "  #{error}" }
  exit(report.errors.empty? ? 0 : 1)
when "migrate"
  game_dir, out_dir = ARGV
  abort "usage: rmxp migrate JEU SORTIE" unless game_dir && out_dir
  result = Rmxp::Migrate.new(game_dir, out_dir).run
  puts "migrate: #{result.scripts} scripts, #{result.regexes} regexes converties, " \
       "#{result.dynamic_flags} flags n retirés, #{result.parse_errors} erreur(s) de parsing"
  puts "sortie: #{File.expand_path(out_dir)}"
when "audit"
  if ARGV.first == "--scripts"
    ARGV.shift
    dir = ARGV.shift
    abort "usage: rmxp audit --scripts DIR" unless dir
    result = Rmxp::Audit.new(nil, nil).run_scripts_dir(dir)
    print_audit(result)
    exit 0
  end
  game_dir = ARGV.shift
  abort "usage: rmxp audit JEU [TRAVAIL] | rmxp audit --scripts DIR" unless game_dir
  work_dir = ARGV.shift || File.join("tmp", "audit", slug(game_dir))
  result = Rmxp::Audit.new(game_dir, work_dir).run
  print_audit(result)
when "help", nil
  puts <<~TEXT
    rmxp — aller-retour des données Pokémon Essentials

      rmxp unpack JEU SORTIE      extrait Data/ et Scripts.rxdata en texte
      rmxp build PROJET SORTIE    reconstruit Data/ et Scripts.rxdata
      rmxp roundtrip JEU [TMP]    unpack + build + comparaison avec l'original
      rmxp check JEU [TMP]        compilation statique des scripts et événements
      rmxp audit JEU [TMP]        inventaire du Ruby dynamique
      rmxp migrate JEU SORTIE     copie + migrations de compatibilité (pré-v19)
  TEXT
else
  abort "commande inconnue: #{command}"
end
