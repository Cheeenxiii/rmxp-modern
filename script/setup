#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Cheeenxiii
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Fetches mkxp-z as a submodule, applies our desktop and Switch patches, and
# installs the Switch RomFS preloads. The Switch changes only take effect in a
# Switch build. Safe to run again: an already patched checkout is left as is.
#
# usage: script/setup

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
mkxpz="$root/vendor/mkxp-z"

# Prints the tree that HEAD of checkout $1 gives with the patches $2... applied.
patched_tree() {
  local repo="$1"; shift
  local index patch tree
  index="$(mktemp)"
  GIT_INDEX_FILE="$index" git -C "$repo" read-tree HEAD
  for patch in "$@"; do GIT_INDEX_FILE="$index" git -C "$repo" apply --cached --whitespace=nowarn "$patch"; done
  tree="$(GIT_INDEX_FILE="$index" git -C "$repo" write-tree)"
  rm -f "$index"
  echo "$tree"
}

# Prints the tree of the tracked files in the working copy of checkout $1.
# Patches are applied with --index, so the files they add are tracked.
working_tree() {
  local index tree
  index="$(mktemp)"
  cp "$(git -C "$1" rev-parse --path-format=absolute --git-path index)" "$index"
  GIT_INDEX_FILE="$index" git -C "$1" add -u
  tree="$(GIT_INDEX_FILE="$index" git -C "$1" write-tree)"
  rm -f "$index"
  echo "$tree"
}

# Applies the patches $2... to the checkout in $1. Skips it if they are
# already applied; refuses if the checkout has other changes.
apply_patches() {
  local repo="$1"; shift
  local patch current
  current="$(working_tree "$repo")"
  if [ "$current" = "$(git -C "$repo" rev-parse 'HEAD^{tree}')" ]; then
    for patch in "$@"; do git -C "$repo" apply --index --whitespace=nowarn "$patch"; done
    echo "applied $# patches to vendor/mkxp-z"
  elif [ "$current" = "$(patched_tree "$repo" "$@")" ]; then
    echo "vendor/mkxp-z is already patched"
  else
    echo "vendor/mkxp-z has changes that are not our patches." >&2
    echo "Reset it with: git -C vendor/mkxp-z reset --hard" >&2
    exit 1
  fi
}

git -C "$root" submodule update --init vendor/mkxp-z
apply_patches "$mkxpz" "$root"/patches/mkxp-z/*.patch "$root"/patches/mkxp-z-switch/*.patch

mkdir -p "$mkxpz/switch/romfs-root/preload"
cp "$root"/patches/mkxp-z-switch/*.rb "$mkxpz/switch/romfs-root/preload/"
# One source for the net/http + URI Shim Reborn needs: the game-side compat
# file, also copied into the console build's RomFS preloads.
cp "$root/lib/rmxp/preload/compat/stdlib_net_http_stub.rb" "$mkxpz/switch/romfs-root/preload/"

echo "Done. See docs/setup.md to build."
