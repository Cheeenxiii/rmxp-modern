#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Cheeenxiii
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Creates a virtual Xbox-like gamepad through Linux's /dev/uinput, so SDL (and
# therefore mkxp-z and the emulators) sees a real controller. Test-only.
#
# usage: script/virtual-pad
#
# Reads commands on stdin, one per line:
#   a down | a up | b down | ... (a, b, x, y, tl, tr, start, back)
#   axis x 200 | axis y 64 | axis rx 128 | axis ry 128 | axis tl 0 | axis tr 255
#   hat up | hat down | hat left | hat right | hat center
#   sleep 250            (milliseconds)
#
# Example:
#   mkfifo /tmp/pad; script/virtual-pad </tmp/pad &
#   printf 'a down\nsleep 80\na up\n' > /tmp/pad
#
# Needs write access to /dev/uinput (root or a udev rule granting it). In a
# container, run with --privileged and bind-mount /dev.
set -eu

[ -w /dev/uinput ] || { echo "no writable /dev/uinput; this needs root or a udev rule" >&2; exit 1; }
command -v cc >/dev/null || { echo "cc not found; cannot build the pad helper" >&2; exit 1; }

dir="$(cd "$(dirname "$0")/.." && pwd)/tmp/virtual-pad"
mkdir -p "$dir"
bin="$dir/vpad"
if [ ! -x "$bin" ] || [ "$0" -nt "$bin" ]; then
  cat > "$dir/vpad.c" <<'C'
#include <linux/uinput.h>
#include <fcntl.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <sys/ioctl.h>

static int fd;
static void emit(int type, int code, int value) {
  struct input_event ev = {.type = type, .code = code, .value = value};
  write(fd, &ev, sizeof(ev));
}
static void sync_now(void) { emit(EV_SYN, SYN_REPORT, 0); }

static int key_of(const char *name) {
  if (!strcmp(name, "a")) return BTN_SOUTH;
  if (!strcmp(name, "b")) return BTN_EAST;
  if (!strcmp(name, "x")) return BTN_NORTH;
  if (!strcmp(name, "y")) return BTN_WEST;
  if (!strcmp(name, "tl")) return BTN_TL;
  if (!strcmp(name, "tr")) return BTN_TR;
  if (!strcmp(name, "start")) return BTN_START;
  if (!strcmp(name, "back")) return BTN_SELECT;
  return -1;
}

int main(void) {
  fd = open("/dev/uinput", O_WRONLY | O_NONBLOCK);
  if (fd < 0) { perror("open /dev/uinput"); return 1; }
  ioctl(fd, UI_SET_EVBIT, EV_KEY);
  ioctl(fd, UI_SET_EVBIT, EV_ABS);
  int keys[] = {BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST, BTN_TL, BTN_TR,
                BTN_START, BTN_SELECT, BTN_DPAD_UP, BTN_DPAD_DOWN,
                BTN_DPAD_LEFT, BTN_DPAD_RIGHT, BTN_THUMBL, BTN_THUMBR};
  for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++)
    ioctl(fd, UI_SET_KEYBIT, keys[i]);
  ioctl(fd, UI_SET_ABSBIT, ABS_X);
  ioctl(fd, UI_SET_ABSBIT, ABS_Y);
  ioctl(fd, UI_SET_ABSBIT, ABS_Z);
  ioctl(fd, UI_SET_ABSBIT, ABS_RZ);
  ioctl(fd, UI_SET_ABSBIT, ABS_HAT0X);
  ioctl(fd, UI_SET_ABSBIT, ABS_HAT0Y);
  struct uinput_abs_setup abs;
  int axes[] = {ABS_X, ABS_Y, ABS_Z, ABS_RZ};
  for (int i = 0; i < 4; i++) {
    memset(&abs, 0, sizeof(abs));
    abs.code = axes[i];
    abs.absinfo.minimum = 0;
    abs.absinfo.maximum = 255;
    ioctl(fd, UI_ABS_SETUP, &abs);
  }
  for (int i = 0; i < 2; i++) {
    memset(&abs, 0, sizeof(abs));
    abs.code = i == 0 ? ABS_HAT0X : ABS_HAT0Y;
    abs.absinfo.minimum = -1;
    abs.absinfo.maximum = 1;
    ioctl(fd, UI_ABS_SETUP, &abs);
  }
  struct uinput_setup setup;
  memset(&setup, 0, sizeof(setup));
  setup.id.bustype = BUS_USB;
  setup.id.vendor = 0x045e;
  setup.id.product = 0x028e;
  setup.id.version = 0x0114;
  strcpy(setup.name, "Microsoft X-Box 360 pad");
  ioctl(fd, UI_DEV_SETUP, &setup);
  ioctl(fd, UI_DEV_CREATE);
  emit(EV_ABS, ABS_X, 128);
  emit(EV_ABS, ABS_Y, 128);
  emit(EV_ABS, ABS_Z, 0);
  emit(EV_ABS, ABS_RZ, 0);
  sync_now();
  printf("virtual pad ready\n");
  fflush(stdout);

  char line[128];
  int value;
  while (fgets(line, sizeof(line), stdin)) {
    char what[32], arg[32];
    if (sscanf(line, "%31s %31s %d", what, arg, &value) < 2)
      continue;
    if (!strcmp(what, "hat")) {
      if (!strcmp(arg, "up")) emit(EV_ABS, ABS_HAT0Y, -1);
      else if (!strcmp(arg, "down")) emit(EV_ABS, ABS_HAT0Y, 1);
      else if (!strcmp(arg, "left")) emit(EV_ABS, ABS_HAT0X, -1);
      else if (!strcmp(arg, "right")) emit(EV_ABS, ABS_HAT0X, 1);
      else { emit(EV_ABS, ABS_HAT0Y, 0); emit(EV_ABS, ABS_HAT0X, 0); }
    } else if (!strcmp(what, "axis")) {
      int axis = !strcmp(arg, "x") ? ABS_X : !strcmp(arg, "y") ? ABS_Y
               : !strcmp(arg, "rx") ? ABS_Z : !strcmp(arg, "ry") ? ABS_RZ
               : !strcmp(arg, "tl") ? ABS_Z : ABS_RZ;
      emit(EV_ABS, axis, value);
    } else if (!strcmp(what, "sleep")) {
      usleep(value * 1000);
    } else {
      int key = key_of(what);
      if (key >= 0) emit(EV_KEY, key, !strcmp(arg, "down"));
    }
    sync_now();
    fflush(stdout);
  }
  ioctl(fd, UI_DEV_DESTROY);
  return 0;
}
C
  cc -O2 -o "$bin" "$dir/vpad.c"
fi
exec "$bin"
